# Python
__pycache__/
*.py[cod]
.venv/
venv/

# CSV cache — re-downloaded when you run ingest
.cache/

# ChromaDB — rebuilt by scripts/ingest/. Not committed, to keep the repo small.
# Anyone cloning runs `python scripts/ingest` once.
chroma_db/

# Sampling runs (--source, --max-audits) write here instead of over the
# real databases; half-finished builds land in .part / .old.
*.sample.db
*.db.part
chroma_db.sample/
chroma_db.old/

# Derived and profile-specific. These are filtered and scored against
# vault/profiles/my-company.md, so they are NOT portable — a different
# profile has to rebuild them, and re-running the ingest is a re-scoring
# rather than a refresh.
#
# data/crosswalk.db is deliberately NOT ignored: it derives from
# org_aliases.yaml, which is a fact about the Government of Canada rather
# than about any one firm, and it's 53KB.
data/contracts.db
data/plans.db
data/oag.db
# Not profile-scored — the lobbying registry is the same for everyone — but
# ignored anyway on size: a three-year window is ~38MB, and the source cannot
# be re-fetched by CI (Cloudflare challenge), so a committed copy would rot
# with nothing able to refresh it. Rebuild locally from the downloaded zip.
data/lobbying.db
data/registrations.db
# Quarantined builds: a database built from a development or archived copy
# rather than an official download, renamed so nothing serves it as current.
data/*UNOFFICIAL
# Hand-acquired source archives. data/source/ is the documented drop path for
# input artifacts that the ingests cannot fetch themselves — currently the OCL
# lobbying zip, which lobbycanada.gc.ca serves only to browsers. Ignored because
# it is bulk upstream data, not something this repo should redistribute.
data/source/
vault/intel/agencies/

# Working state — private. The reference material in vault/reference/ is
# committed because it's how the system works. What we're actually bidding
# on is not.
vault/tenders/
vault/briefings/
vault/searches/
# Department nodes. Same category as vault/tenders/: the directory listing
# alone publishes which departments are being pursued, and the node exists so
# private notes accumulate in it. Durability is Obsidian sync's job, not a
# public repo's.
vault/agencies/

# Obsidian per-machine settings — pane layout, theme, window position
vault/.obsidian/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
